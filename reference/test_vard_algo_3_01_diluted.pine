init_tree_root() =>
    a = array.from(0, 47, 88, 137, 182, 225, 272, 319, 366, 417, 468, 513, 560, 607, 656, 705, 746, 789, 842, 891, 934, 983, 1030, 1069, 1128, 1175, 1220, 1261, 1306, 1349, 1398, 1437, 1484, 1517, 1556, 1603, 1642, 1685, 1724, 1773, 1822, 1859, 1904, 1945, 1998, 2045, 2094, 2141, 2188, 2221, 2260, 2309, 2354, 2383, 2422, 2465, 2508, 2547, 2598, 2643, 2692, 2731, 2764, 2807, 2852, 2901, 2940, 2981, 3020, 3067, 3102, 3145, 3194, 3219, 3266, 3313, 3356, 3397, 3442, 3467)
    a
var array<int> node_feat = init_node_feat()
var array<float> node_thr = init_node_thr()
var array<int> node_left = init_node_left()
var array<int> node_right = init_node_right()
var array<int> tree_root = init_tree_root()

eps_ttm = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE_DILUTED", "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
pe_raw  = (not na(eps_ttm) and eps_ttm != 0) ? close / eps_ttm : na
pe_raw  := na(pe_raw) ? pe_raw[1] : pe_raw

pe_min_p = ta.lowest(pe_raw,  window_days)
pe_max_p = ta.highest(pe_raw, window_days)
hist_pct = float(na)
if not na(pe_min_p) and not na(pe_max_p) and pe_max_p > pe_min_p and not na(pe_raw)
    pos = (pe_raw - pe_min_p) / (pe_max_p - pe_min_p) * 100
    hist_pct := math.max(0.0, math.min(100.0, pos))
hist_pct_ema = ta.ema(hist_pct, hist_ema_len)

pct_long = float(na)
if not na(pe_raw) and bar_index >= window_long
    cnt = 0
    tot = 0
    for i = 0 to window_long - 1
        if not na(pe_raw[i])
            tot += 1
            if pe_raw[i] < pe_raw
                cnt += 1
    if tot > 0
        pct_long := cnt / tot * 100

pe_inner   = ta.sma(pe_raw, inner_period)
pe_double  = ta.sma(pe_inner, outer_period)
pe_sma39   = ta.sma(pe_raw, sma39_period)
pe_lag     = pe_raw[lag_period]
pe_ref     = w_double*pe_double + w_sma39*pe_sma39 + w_lag*pe_lag
gap_pct    = not na(pe_ref) and pe_ref != 0 and not na(pe_raw) ? (pe_raw - pe_ref) / pe_ref * 100 : na

pe_sma_avv = ta.sma(pe_raw, avv_period)
pe_std_avv = ta.stdev(pe_raw, avv_period)
avv_z      = pe_std_avv > 0 and not na(pe_raw) ? (pe_raw - pe_sma_avv) / pe_std_avv : na
avv_raw    = na(avv_z) ? na : avv_scale * avv_z

pe_std_score = ta.stdev(pe_raw, std_score_period)
z_gap = pe_std_score > 0 and not na(pe_raw) and not na(pe_ref) ? (pe_raw - pe_ref) / pe_std_score : na

// --- Linjär bas-score ---
compute_lin(gap, avv, h_ema, z_g) =>
    if na(gap) or na(z_g) or na(h_ema)
        float(na)
    else
        gc = math.max(-LIN_CLIP, math.min(LIN_CLIP, gap))
        cnd = gap * avv > 0 ? avv : 0.0
        cb = LIN_W_GAP*gc + (1-LIN_W_GAP)*z_g*LIN_Z_SCALE + LIN_A_COND*cnd + LIN_P_COEF*(h_ema-50)
        cbf = cb + LIN_QUAD*cb*math.abs(cb)
        math.max(0.0, math.min(100.0, (cbf + LIN_OFFSET) * LIN_SCALE))

lin_score = compute_lin(gap_pct, avv_raw, hist_pct_ema, z_gap)

// --- GBM-evaluering ---
get_feature(idx, f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11) =>
    idx == 0  ? f0 : idx == 1  ? f1 : idx == 2  ? f2 : idx == 3  ? f3 :
     idx == 4  ? f4 : idx == 5  ? f5 : idx == 6  ? f6 : idx == 7  ? f7 :
     idx == 8  ? f8 : idx == 9  ? f9 : idx == 10 ? f10 : idx == 11 ? f11 : na

eval_gbm(f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11) =>
    b = 0.0
    for t = 0 to array.size(tree_root) - 1
        node = array.get(tree_root, t)
        for steps = 0 to 50
            feat = array.get(node_feat, node)
            if feat < 0
                break
            thr = array.get(node_thr, node)
            fv = get_feature(feat, f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11)
            node := fv <= thr ? array.get(node_left, node) : array.get(node_right, node)
        b := b + array.get(node_thr, node)
    b

