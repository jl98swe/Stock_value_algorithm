    negpe_t_arr = array.from(51.981,2.0743,0,50.401,0,0,55.137,4.7973,0,0,59.822,0,0,52.842,15.125,38.45,0,0,50.401,0,0,56.153,47.347,0,0,0,51.981,2.0743,0,50.037,0,0,57.19,4.6004,0,0,61.07,0,0,49.546,2.0743,0,48.849,0,0,55.137,54.977,0,0,55.542,0,0,52.842,47.894,2.0743,0,0,0,47.133,55.828,0,0,24.017,0,0,48.23,29.441,0,75.171,0,0,42.934,56.686,0,0,84.334,0,0,53.85,46.606,2.2012,0,0,0,47.133,21.426,0,0,13.62,0,0,53.85,45.97,2.3964,0,0,26.838,0,0,60.642,1.1285,0,0,0,49.397,45.566,0,45.067,0,0,60.642,13.62,0,0,50.919,0,0,49.993,56.443,43.562,0,0,60.642,0,0,45.97,0,82.338,0,0,53.959,43.872,47.133,0,0,60.426,0,0,47.133,60.283,0,0,0,53.959,44.908,2.5235,0,0,47.788,0,0,12.744,0,60.642,0,0,49.993,22.307,0,56.443,0,0,44.908,135.01,0,0,26.838,0,0,49.993,21.426,61.295,0,0,56.443,0,0,44.908,40.75,0,0,0,49.205,21.426,0,58.764,0,0,40.75,137.07,0,0,47.049,0,0,49.205,21.426,0,90.007,0,0,86.575,13.62,0,0,58.265,0,0,53.959,40.75,13.836,0,0,92.857,0,0,47.133,21.426,0,0,0,50.443,20.993,0,58.764,0,0,40.75,137.07,0,0,46.124,0,0,50.712,18.21,0,56.443,0,0,40.75,15.628,0,0,92.615,0,0,50.712,18.21,0,41.611,0,0,86.575,10.788,0,0,58.265,0,0,53.959,90.852,43.294,0,0,94.257,0,0,12.744,0,60.458,0,0,53.57,18.21,60.642,0,0,56.443,0,0,40.75,0,92.615,0,0,53.959,90.852,53.57,0,0,55.542,0,0,12.744,0,46.293,0,0,53.959,40.75,53.57,0,0,0,45.328,60.642,0,0,67.775,0,0,53.959,40.75,13.836,0,0,93.863,0,0,12.744,0,46.293,0,0,53.57,18.21,44.524,0,0,56.443,0,0,40.75,0,93.863,0,0,53.959,40.75,53.57,0,0,0,44.905,62.064,0,0,67.775,0,0,53.959,40.75,13.836,0,0,93.863,0,0,12.744,0,46.293,0,0,53.959,40.75,13.836,0,0,93.863,0,0,12.744,0,46.293,0,0,53.959,40.75,13.836,0,0,93.863,0,0,12.744,0,46.293,0,0)
    negpe_v_arr = array.from(0,0,24.028,0,39.028,29.363,0,0,29.369,25.18,0,24.028,24.028,0,0,0,-3.6042,2.424,0,9.1458,1.0663,0,0,-3.6042,-0.23578,-3.6042,0,0,-3.0636,0,7.7739,0.19905,0,0,0.76279,-3.0636,0,-3.0636,-3.0636,0,0,-2.604,0,6.6079,0.42911,0,0,-0.79683,1.5901,0,-2.604,0.056262,0,0,0,-2.2134,5.6167,0.24122,0,0,-2.2134,-2.2134,0,-1.334,0.42399,0,0,-1.8814,0,-1.8178,0.89739,0,0,-0.4715,1.3965,0,4.2475,4.7742,0,0,0,-1.5992,4.058,0.24436,0,0,-1.5992,-1.6087,0,-1.5643,-0.1613,0,0,0,-1.3593,3.4493,0,0.45316,-0.17722,0,0,0.82488,-1.3593,-1.3593,0,0,-0.39995,0,2.9319,1.1093,0,0,-1.1554,-0.32122,0,-1.1554,-0.4516,0,0,0,-0.98211,0.18308,0,-0.98211,-0.98211,0,2.4921,0,0.3477,-0.92057,0,0,0,-0.50428,2.1183,0,0.092399,1.7235,0,0,-0.83479,-0.83479,-0.31261,0,0,0,-0.87247,1.8006,0,0.86081,-0.005798,0,-0.70957,0,-0.75046,-0.70957,0,0,-0.60314,0,0.084583,-0.61125,0,0,1.5305,-0.017401,0,0.76209,-0.26809,0,0,0,-0.51267,-0.51267,0,0.06807,-0.51956,0,0,1.3009,1.3009,0.26856,0,0,-0.43577,0,-0.036601,-0.44163,0,0,1.1058,-1.2004,0,1.1058,0.05852,0,0,-0.3704,0,-0.36584,1.8594,0,0,-0.55882,0.93991,0,0.93991,0.93991,0,0,0,-0.4533,0.79893,0,0.17898,0.79893,0,0,-0.31484,-0.32051,-0.24428,0,0,-0.26761,0,-0.021097,-0.27243,0,0,0.67909,-1.6996,0,0.73831,0.037902,0,0,-0.22747,0,0.034962,-0.23157,0,0,-2.9335,0.57722,0,0.26334,0.56834,0,0,-0.19335,0,-0.19683,-0.10873,0,0,0.61874,0.20667,0,0.49064,0.49064,0,0,0,0.45964,0.022903,0,0.41704,0.41704,0,-0.16435,0,-0.28335,-0.16435,0,0,0,-0.1397,-0.1397,0,0.024079,-0.14265,0,0.35449,0,0.31791,0.34694,0,0,0,-0.1667,0.3547,0,0.30131,0.30131,0,-0.11874,0,-0.12126,0.0048032,0,0,0,-0.11487,0.25612,0.17198,0,0,-0.10093,-0.10093,0,-0.031294,-0.26943,0,0,0,-0.2878,0.2177,0,0.062529,0.2239,0,-0.085791,0,-0.087928,0.0087767,0,0,0,-0.072922,-0.083368,0,0.023818,-0.074739,0,0.18504,0,0.25145,0.19032,0,0,0,-0.13387,0.15729,0.11892,0,0,-0.061984,-0.061984,0,-0.060417,-0.067859,0,0,0,-0.21361,0.13369,0,0.018517,0.14393,0,-0.052686,0,-0.054231,-0.0034269,0,0,0,-0.18157,0.11364,0,0.01574,0.12234,0,-0.044783,0,-0.046096,-0.0029129,0,0,0,-0.15433,0.096595,0,0.013379,0.10399,0,-0.038066,0,-0.039182,-0.0024759)
    [negpe_ts_arr, negpe_l_arr, negpe_r_arr, negpe_f_arr, negpe_t_arr, negpe_v_arr]

eval_negpe_gbm(gap, avv, abs_pe, pe_d5, pe_vol20, hist_60) =>
    [ts, l, r, f, t, v] = init_negpe_arrays()
    feats = array.from(gap, avv, abs_pe, pe_d5, pe_vol20, hist_60)
    total = 0.0
    for i = 0 to array.size(ts) - 1
        node = array.get(ts, i)
        for k = 0 to 10
            ff = array.get(f, node)
            if ff == -1
                break
            node := array.get(feats, ff) <= array.get(t, node) ? array.get(l, node) : array.get(r, node)
        total += array.get(v, node)
    total

can_run = not na(gap_pct) and not na(avv_raw) and not na(hist_pct) and not na(hist_pct_ema) and not na(pct_long) and not na(z_gap) and not na(pe_std_score) and not na(gap_pct[5]) and not na(hist_pct_ema[5]) and not na(pct_long[5]) and not na(avv_raw[5]) and not na(z_gap[5])

boost = can_run ? eval_gbm(gap_pct, avv_raw, hist_pct, hist_pct_ema, pct_long, z_gap, pe_std_score, gap_pct[5], hist_pct_ema[5], pct_long[5], avv_raw[5], z_gap[5]) : 0.0

// --- Negativ-PE specialfall via GBM ---
// PE-derivata-features behövs för GBM-modellen
pe_d5_neg = not na(pe_raw) and not na(pe_raw[5]) ? pe_raw - pe_raw[5] : na
pe_vol20_neg = ta.stdev(pe_raw, 20)
pe_low60 = ta.lowest(pe_raw, 60)
pe_high60 = ta.highest(pe_raw, 60)
hist_60_neg = not na(pe_raw) and not na(pe_low60) and not na(pe_high60) and pe_high60 > pe_low60 ? math.max(0.0, math.min(100.0, (pe_raw - pe_low60) / (pe_high60 - pe_low60) * 100)) : na

neg_pe_score = float(na)
if not na(pe_raw) and pe_raw < 0 and not na(gap_pct) and not na(avv_raw) and not na(pe_d5_neg) and not na(pe_vol20_neg) and not na(hist_60_neg)
    g_neg = math.max(0.0, math.min(100.0, gap_pct + 50))
    a_neg = math.max(0.0, math.min(100.0, avv_raw + 50))
    neg_pe_score := eval_negpe_gbm(g_neg, a_neg, math.abs(pe_raw), pe_d5_neg, pe_vol20_neg, hist_60_neg)
    neg_pe_score := math.max(0.0, math.min(100.0, neg_pe_score))

score = not na(neg_pe_score) ? neg_pe_score : (na(lin_score) ? na : (can_run ? math.max(0.0, math.min(100.0, lin_score + boost)) : lin_score))

prisznn = na(score) ? "N/A" : score >= 80 ? "Övervärderad" : score >= 60 ? "Relativt Dyr" : score >= 40 ? "Neutral" : score >= 20 ? "Relativt Attraktiv" : "Undervärderad"

// ─── Färgade bakgrundszoner (5 boxes, slutar vid senaste bar) ─
// Använder time-koordinater (xloc.bar_time) för att undvika bar-index-gränsen vid lång historia
var int chart_start_time = na
if na(chart_start_time)
    chart_start_time := time

var box box_80_100 = na
var box box_60_80  = na
var box box_40_60  = na
var box box_20_40  = na
var box box_0_20   = na
if barstate.islast
    if not na(box_80_100)
        box.delete(box_80_100)
        box.delete(box_60_80)
        box.delete(box_40_60)
        box.delete(box_20_40)
        box.delete(box_0_20)
    box_80_100 := box.new(left=chart_start_time, top=100, right=time, bottom=80, bgcolor=col_zone_80_100, border_color=color.new(color.white, 100), xloc=xloc.bar_time)
    box_60_80  := box.new(left=chart_start_time, top=80,  right=time, bottom=60, bgcolor=col_zone_60_80,  border_color=color.new(color.white, 100), xloc=xloc.bar_time)
    box_40_60  := box.new(left=chart_start_time, top=60,  right=time, bottom=40, bgcolor=col_zone_40_60,  border_color=color.new(color.white, 100), xloc=xloc.bar_time)
    box_20_40  := box.new(left=chart_start_time, top=40,  right=time, bottom=20, bgcolor=col_zone_20_40,  border_color=color.new(color.white, 100), xloc=xloc.bar_time)
    box_0_20   := box.new(left=chart_start_time, top=20,  right=time, bottom=0,  bgcolor=col_zone_0_20,   border_color=color.new(color.white, 100), xloc=xloc.bar_time)

// ─── Tröskellinjer (av som default — togglas i Style-fliken) ──
hline(80, "Övervärderad",       color=color.new(color.red,   50), linestyle=hline.style_dashed, display=display.none)
hline(60, "Relativt Dyr",       color=color.new(color.orange,50), linestyle=hline.style_dotted, display=display.none)
hline(40, "Relativt Attraktiv", color=color.new(color.green, 50), linestyle=hline.style_dotted, display=display.none)
hline(20, "Undervärderad",      color=color.new(color.green, 50), linestyle=hline.style_dashed, display=display.none)
hline(50, "Mittlinje (0 för gap/avv)", color=color.new(color.gray, 70))

// ─── Plottar (gap och avv förskjutna så 0 -> 50 i skalan) ─────
// Clampa till 0-100 så extrema värden inte zoomar ut hela panelen
gap_scaled = na(gap_pct) ? na : math.max(0.0, math.min(100.0, gap_pct + 50))
avv_scaled = na(avv_raw) ? na : math.max(0.0, math.min(100.0, avv_raw + 50))

score_color = na(score) ? color.gray : score >= 80 ? col_overval : score >= 60 ? col_rel_dyr : score >= 40 ? col_neutral : score >= 20 ? col_rel_attr : col_underval

// Score-värde visas FÖRST i status line (men ritas EJ i pane från denna plot)
plot(score, "Värderingspoäng_X", color=score_color, linewidth=3, precision=2, display=display.status_line + display.price_scale)

// Gap och avv visas i status line och pane (default ordning)
plot(gap_scaled, "Verkligt Värdegap", color=color.new(color.blue, 0),   style=plot.style_circles, linewidth=1)
plot(avv_scaled, "Avvikelseindex",    color=color.new(color.orange, 40), linewidth=1)

// Score-linjen ritas SIST i pane (för att hamna överst visuellt)
plot(score, "Värderingspoäng_X_linje", color=score_color, linewidth=3, display=display.pane)

// Linjär bas (utan GBM-korrigering) — endast för dataexport/jämförelse, ritas ej i chart
plot(lin_score, "Linjär_bas_X", color=color.new(color.gray, 100), display=display.data_window)

// PE som dolt plot för datafönster/CSV-export (syns ej på chart)
plot(pe_raw, "P/E (TTM)", display=display.data_window)

// ─── Info-ruta (ljus bakgrund som originalet) ─────────────────
if show_table and barstate.islast
    var table tbl = table.new(position.middle_right, 2, 7, border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)
    sc_col = na(score) ? color.gray : score >= 80 ? col_overval : score >= 60 ? col_rel_dyr : score >= 40 ? col_neutral : score >= 20 ? col_rel_attr : col_underval
    cell_bg = color.white

    table.cell(tbl, 0, 0, "Värderingsalgo v3.0", bgcolor=color.new(#1e6091, 0), text_color=color.white, text_size=size.normal)
    table.merge_cells(tbl, 0, 0, 1, 0)

    table.cell(tbl, 0, 1, "Värderingspoäng", text_color=color.black, text_size=size.small, bgcolor=cell_bg)
    table.cell(tbl, 1, 1, na(score) ? "N/A" : str.tostring(score, "#.##"), text_color=sc_col, text_size=size.small, bgcolor=cell_bg)

    table.cell(tbl, 0, 2, "Priszon", text_color=color.black, text_size=size.small, bgcolor=cell_bg)
    table.cell(tbl, 1, 2, prisznn, text_color=sc_col, text_size=size.small, bgcolor=cell_bg)

    gap_color = na(gap_pct) ? color.gray : gap_pct >= 0 ? color.new(#4caf50, 0) : color.red
    gap_text  = na(gap_pct) ? "N/A" : str.tostring(gap_pct, "#.##") + "%"
    table.cell(tbl, 0, 3, "Verkligt Värdegap", text_color=color.black, text_size=size.small, bgcolor=cell_bg)
    table.cell(tbl, 1, 3, gap_text, text_color=gap_color, text_size=size.small, bgcolor=cell_bg)

    avv_color = na(avv_z) ? color.gray : avv_z >= 0 ? color.new(#4caf50, 0) : color.red
    avv_text  = na(avv_z) ? "N/A" : str.tostring(avv_z, "#.#") + "s"
    table.cell(tbl, 0, 4, "Avvikelseindex", text_color=color.black, text_size=size.small, bgcolor=cell_bg)
    table.cell(tbl, 1, 4, avv_text, text_color=avv_color, text_size=size.small, bgcolor=cell_bg)

    pct_text = na(hist_pct) ? "N/A" : str.tostring(hist_pct, "#.#") + "%"
    table.cell(tbl, 0, 5, "Historisk Percentil", text_color=color.black, text_size=size.small, bgcolor=cell_bg)
    table.cell(tbl, 1, 5, pct_text, text_color=color.black, text_size=size.small, bgcolor=cell_bg)

    pe_text = na(pe_raw) ? "N/A" : str.tostring(pe_raw, "#.#")
    pe_bg = not na(pe_raw) and pe_raw < 0 ? color.new(#f23645, 60) : cell_bg
    table.cell(tbl, 0, 6, "P/E-tal (TTM)", text_color=color.black, text_size=size.small, bgcolor=pe_bg)
    table.cell(tbl, 1, 6, pe_text, text_color=color.black, text_size=size.small, bgcolor=pe_bg)