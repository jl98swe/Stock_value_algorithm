//@version=6
indicator("Test värderingsalgo 3.0 (GBM hybrid)", shorttitle="TestVärd3", overlay=false)

// ===========================================================================
// v3.0 - Linjär bas + Gradient Boosted residual-korrigering
//
// Positiv-PE-modell: linjär baseline + GBM (80 träd, depth 5, ~3500 noder)
//   Tränad på 8 svenska/amerikanska aktier (AAPL, PYPL, BAHN, EPI, EVO,
//   NDA, NIBE, VIT) med LOOCV MAE 1.97.
//   OOS-validerad på 7 aktier (SAAB, VOLV, HPOL, MSFT, PEP, HOLM, ADDT,
//   MCD, SCA) med MAE 1.59-2.32.
//
// Negativ-PE-modell: separat GBM (30 träd, depth 3, ~390 noder)
//   Tränad på 7 aktier (EQT, HUFV, SBB, CAST, SNAP, SPOT, HTRO, n=4943)
//   med LOSO MAE 7.11. Använder features: gap, avv, |PE|, pe_d5,
//   pe_vol20, hist_60. Aktiveras automatiskt när P/E < 0.
//   HUFV och CAST är dokumenterade edge cases där originalets formel
//   inte kan reverse-engineeras fullt ut.
//
// Info-rutan visar röd P/E-rad när P/E är negativt — varning om att
// modellens precision är lägre där.
// ===========================================================================

// --- Numeriska parametrar (låsta efter reverse-engineering) ---
window_days      = 20
window_long      = 180
inner_period     = 29
outer_period     = 11
sma39_period     = 39
lag_period       = 19
w_double         = 0.70
w_sma39          = 0.25
w_lag            = 0.05
avv_period       = 20
avv_scale        = 10.259784
std_score_period = 35

// --- Användarinställningar ---
hist_ema_len  = input.int(19, "EMA-längd för hist-percentil")
show_table    = input.bool(true, "Visa info-ruta")

// --- Färger för score-linjen (efter zon) ---
col_overval   = input.color(#b22833,                          "Övervärderad (80-100)",       group="Linjefärger")
col_rel_dyr   = input.color(#f23645,                          "Relativt Dyr (60-80)",        group="Linjefärger")
col_neutral   = input.color(color.gray,                       "Neutral (40-60)",             group="Linjefärger")
col_rel_attr  = input.color(#66bb6a,                          "Relativt Attraktiv (20-40)",  group="Linjefärger")
col_underval  = input.color(#4caf50,                          "Undervärderad (0-20)",        group="Linjefärger")

// --- Färger för bakgrundszoner (opacity = 100 - transp) ---
col_zone_80_100 = input.color(color.new(#f23645, 75),         "Bakgrund 80-100 (Övervärderad)",      group="Zonfärger")
col_zone_60_80  = input.color(color.new(#f23645, 85),         "Bakgrund 60-80 (Relativt Dyr)",       group="Zonfärger")
col_zone_40_60  = input.color(color.new(color.gray, 92),      "Bakgrund 40-60 (Neutral)",            group="Zonfärger")
col_zone_20_40  = input.color(color.new(#4caf50, 85),         "Bakgrund 20-40 (Relativt Attraktiv)", group="Zonfärger")
col_zone_0_20   = input.color(color.new(#4caf50, 75),         "Bakgrund 0-20 (Undervärderad)",       group="Zonfärger")

LIN_W_GAP    = 0.564733
LIN_Z_SCALE  = 4.961122
LIN_A_COND   = 0.051564
LIN_P_COEF   = 0.060012
LIN_QUAD     = 0.028621
LIN_OFFSET   = 14.760836
LIN_SCALE    = 3.324178
LIN_CLIP     = 9.390153

